      "name": "DaytonaCore",
      "id": "CD42C7BC3DF9F4289F1D7D5E",
      "product": "Products/libDaytonaCore.a",
      "product-type": "library.static",
      "legacy-team-id": "",
      "build-phases": [
        "compile-sources",
      ],
      "build-settings": {
        "EXCLUDED_SOURCE_FILE_NAMES": "$(EXCLUDED_GEN_$(ROMSET))",
        "GCC_OPTIMIZATION_LEVEL": "2",
        "GCC_PREPROCESSOR_DEFINITIONS": [
          "M2_ROMSET=\\\"$(ROMSET)\\\"",
          "M2_HAVE_7Z",
          "Z7_PPMD_SUPPORT",
          "SOFTFLOAT_FAST_INT64",
          "LITTLEENDIAN=1",
        ],
        "GCC_WARN_INHIBIT_ALL_WARNINGS": "YES",
        "HEADER_SEARCH_PATHS": [
          "$(SRCROOT)/upstream/src",
          "$(SRCROOT)/upstream/extern/softfloat/source/include",
          "$(SRCROOT)/upstream/extern/ymfm/src",
          "$(SRCROOT)/upstream/extern/lzma/C",
          "$(SRCROOT)/Core",
        ],
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "OTHER_CFLAGS": [
          "-fno-fast-math",
          "-ffp-contract=off",
          "-DTHREAD_LOCAL=_Thread_local",
        ],
        "OTHER_CPLUSPLUSFLAGS": [
          "-fno-fast-math",
          "-ffp-contract=off",
          "-DTHREAD_LOCAL=__thread",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "$(BUNDLE_ID_PREFIX).DaytonaCore",
        "SDKROOT": "xros",
        "SKIP_INSTALL": "YES",
        "TARGETED_DEVICE_FAMILY": "7",
      },
