// Settings shared by every target. Put your own in Local.xcconfig next to
// this file (it is not committed), for example:
//
//   DEVELOPMENT_TEAM = ABCDE12345
//   BUNDLE_ID_PREFIX = com.example
//   ROMSET = daytona93
//
// ROMSET picks the game the app is built with: daytona (Revision A, 1994) or
// daytona93 (Deluxe '93). Its code is generated by upstream's setup, which
// writes Revision A to upstream/build-daytona/gen and Deluxe '93 to
// upstream/build/gen; the other set's folder is left out of the build.
//
// BUNDLE_ID_PREFIX makes the app's identifier yours (app identifiers belong
// to one signing team): BUNDLE_ID_PREFIX.daytona-vision.

ROMSET = daytona
DEVELOPMENT_TEAM =
BUNDLE_ID_PREFIX = com.example

EXCLUDED_GEN_daytona = */upstream/build/gen/*
EXCLUDED_GEN_daytona93 = */upstream/build-daytona/gen/*

#include? "Local.xcconfig"
